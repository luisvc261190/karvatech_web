# Copia este archivo como backend/.env y completa los valores reales.
# backend/.env está ignorado por git: nunca subir credenciales.

# PostgreSQL en Neon Cloud (pooler). sslmode=require se conserva;
# channel_binding se normaliza automáticamente en db.py.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-POOLER.REGION.aws.neon.tech/BASE?sslmode=require&channel_binding=require

# Cuenta administradora del panel (se crea en el primer arranque).
# Si KARVATECH_ADMIN_PASSWORD queda vacío, se genera y se guarda en
# backend/credentials.txt.
KARVATECH_ADMIN_USER=admin
KARVATECH_ADMIN_NAME=Administrador
KARVATECH_ADMIN_PASSWORD=

# Duración de la sesión del panel en minutos (por defecto 480).
KARVATECH_SESSION_MINUTES=480

# Orígenes permitidos para CORS (separados por coma).
KARVATECH_ALLOWED_ORIGINS=http://localhost:5173

# Activa HSTS (pon 1 solo en producción con HTTPS).
KARVATECH_HSTS=0

# --- Correos desde el panel administrativo -------------------------------
# Si SMTP_HOST queda vacío, el panel solo guarda las respuestas y ofrece
# el enlace "Abrir en tu correo" (mailto). Con SMTP configurado, el botón
# "Enviar respuesta" envía el correo real al cliente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=KARVATECH
SMTP_USE_TLS=1
SMTP_USE_SSL=0